# Copy to .env (gitignored) and fill in. Never commit real values.
# Meta Model API (owner-provisioned).
MODEL_API_KEY=
MODEL_ID=muse-spark-1.3
MODEL_ID_SAFETY=muse-wonder-1.0
META_BASE_URL=https://api.meta.ai/v1
META_REASONING_EFFORT=minimal
# Postgres connection string.
DATABASE_URL=
# Demo API token (shared Bearer [REDACTED] demo routes; empty leaves them open locally).
DEMO_API_TOKEN=
NEXT_PUBLIC_DEMO_API_TOKEN=
DEMO_RESET_ENABLED=
# Twilio (owner-provisioned; test mode for local dev).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PHONE_TEST_DESTINATION=
PHONE_TEST_MODE=
PHONE_WEBHOOK_BASE_URL=
# Server bind (loopback for local dev).
HOST=127.0.0.1
PORT=8000
PYTHONPATH=backend
